# Client (Vite) build-time variables.
#
# IMPORTANT: VITE_* variables are inlined into the SPA bundle at `vite build` time.
# They must be present in the environment where the BUILD runs — for the Cloudflare
# git deploy that's "Workers Builds → Build → Variables", NOT the Worker's runtime
# "Variables and Secrets" (those never reach the built frontend). Locally, copy this
# to `.env` (gitignored).

# Cloudflare Turnstile — PUBLIC site key for the contact-form captcha. Safe to expose.
# Pair it with the secret set as a Worker secret: `wrangler secret put TURNSTILE_SECRET`.
# Cloudflare's always-pass TEST key (visible widget, no real verification):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
