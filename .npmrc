# legacy-peer-deps is required by ops2's accepted router interim, and only by it.
#
# `@ionic/react-router@8.8.18` declares a peer on `react-router@^5`. This repo's
# root slot holds `react-router@7.13.0` for the customer site, and npm 11 insists
# on satisfying a peer at the root — so it refuses the tree, whatever the
# `overrides` block says. (The ops2 design predicted the overrides would silence
# this; on npm 11 they do not. They still do useful work: they pin the nested v5
# spec so it cannot drift away from the aliased copy.)
#
# The peer is bookkeeping, not runtime. `vite.ops2.config.ts` aliases every bare
# `react-router` import in the ops2 graph to `node_modules/react-router-5`, so
# exactly one v5 module instance is ever bundled. What npm records about that
# peer changes nothing about what ships.
#
# THE TRAP THIS FLAG SETS, AND WHY react/react-dom ARE NOW REAL DEPENDENCIES:
# with peer resolution off, npm installs no package that is *only* peered. React
# was in that position — declared solely in this manifest's `peerDependencies`
# and depended on by nothing — so the first install under this flag deleted
# react and react-dom from node_modules outright. They are now declared in
# `dependencies` at the same 18.3.1 they were always pinned to. Do not move them
# back while this flag is set.
#
# Remove this file when Ionic ships React Router 6/7 support and the alias
# package goes away (`docs/design/ops2-ionic-boundary.md` §2.5, on
# `design/ops2-planning`); `scripts/tests/ops2-deps.test.mjs` is what notices if
# the arrangement drifts before then.
legacy-peer-deps=true
