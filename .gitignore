# Dependencies — reinstalled from package-lock.json on each build.
# (Committing node_modules breaks Linux CI/Vercel: Windows files lose the
#  executable bit, so node_modules/.bin/vite fails with "Permission denied".)
node_modules/

# Build output — regenerated by `vite build`
dist/
dist-ssr/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Env files
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
*.local

# Vercel
.vercel/

# Wrangler / Cloudflare local state (local D1, KV, R2, caches)
.wrangler/
.wrangler-dry-run/
.codex-tmp/

# Playwright E2E artifacts
playwright-report/
test-results/
coverage/
!.env.production

# Feature handoff artifacts (delivery notes + patches, not source)
/CODE_AGENT_HANDOFF.md
/SCHEDULE_UPLOAD_IMPLEMENTATION.md
/Verdict-Response.md
/*.patch

# Sanity Studio build artifacts (generated by `sanity dev`/`deploy`)
sanity/.sanity/
sanity/dist/

# D1 production exports taken before remote migrations — never commit
backup-*.sql

# Dataset exports taken as pre-change backups. Large, and a copy of production
# content -- keep them locally, never in the repo.
sanity/backups/

# Rendered pages and crops of customer drawings. These are fragments of a
# customer's own plan set and must never enter git.
#
# The rule lives HERE, at the root, because the last one did not: a .gitignore
# inside containers/plan-parse/ was the only thing keeping three crops out, and
# when a revert deleted that directory's .gitignore the crops stopped being
# ignored and `git add -A` committed them (0f63fe6a, removed in #26 — still in
# history). A guard one deletion away from failing is not a guard.
containers/**/out/
**/plan-parse/out/
