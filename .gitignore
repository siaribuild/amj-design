# Dependencies — reinstalled from package-lock.json on each build.
# (Committing node_modules breaks Linux CI/Vercel: Windows files lose the
#  executable bit, so node_modules/.bin/vite fails with "Permission denied".)
node_modules/

# Build output — regenerated by `vite build`
dist/
dist-ssr/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Env files
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
*.local

# Vercel
.vercel/

# Wrangler / Cloudflare local state (local D1, KV, R2, caches)
.wrangler/
.wrangler-dry-run/
.codex-tmp/

# Playwright E2E artifacts
playwright-report/
test-results/
coverage/
!.env.production

# Feature handoff artifacts (delivery notes + patches, not source)
/CODE_AGENT_HANDOFF.md
/SCHEDULE_UPLOAD_IMPLEMENTATION.md
/Verdict-Response.md
/*.patch

# Sanity Studio build artifacts (generated by `sanity dev`/`deploy`)
sanity/.sanity/
sanity/dist/

# D1 production exports taken before remote migrations — never commit
backup-*.sql

# Dataset exports taken as pre-change backups. Large, and a copy of production
# content -- keep them locally, never in the repo.
sanity/backups/
