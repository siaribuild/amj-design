{
  "name": "apertly",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",

  // Built Vite SPA. The Worker serves these via the ASSETS binding; unmatched
  // client-side routes fall back to index.html (handled in worker/index.ts).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker first so it can pick the SPA shell by host (customer vs
    // ops.*). Without this the asset system serves "/" as index.html directly.
    "run_worker_first": true
  },

  // ── Bindings ──────────────────────────────────────────────────────────────
  // Local dev (`wrangler dev`, `--local` D1/KV/R2) works with the placeholder
  // ids below. Before deploying, create the real resources and paste the ids:
  //   wrangler d1 create apertly-db
  //   wrangler kv namespace create apertly-kv
  //   wrangler r2 bucket create apertly-files
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apertly-db",
      "database_id": "fb104839-cbb5-402c-a48f-be2696483bef",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "f7433a11f02f46639053d919dd9b488a" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "apertly-files" }
  ],

  // Workers AI — the schedule-parse ACCURACY tier (toMarkdown + LLM / vision).
  // Optional: the default on-stack deterministic extractor runs without it. Bind
  // the account's Workers AI and, if desired, route it through an AI Gateway for
  // caching + cost controls. No further provisioning needed to enable this binding.
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [
      { "binding": "AI_JOBS", "queue": "apertly-ai-jobs" }
    ],
    "consumers": [
      {
        "queue": "apertly-ai-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "apertly-ai-jobs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "vars": {
    // Schedule extraction engine: 'deterministic' (default, on-stack, no model
    // spend), 'auto' (deterministic, escalate to Workers AI when weak — needs the
    // AI binding), or 'ai' (force Workers AI). Leave as deterministic until AI is
    // provisioned; then switch to 'auto' for messy/scanned schedules.
    "PARSE_ENGINE": "deterministic",
    // AI Gateway (owner-provisioned 2026-07-25): routes every model call through
    // the gateway's spend cap ($20/mo), rate limit (10/min) and unified billing.
    // Payload logging is off in the gateway AND enforced per-request in code
    // (collectLog:false). Model selection lives in code: google/gemini-3.6-flash
    // by default; override with AI_PRIMARY_MODEL without a code change.
    "AI_GATEWAY_ID": "openframe-estimator",
    // AI extraction fires automatically on every clean upload ('auto'); set to
    // 'manual' only as an emergency kill-switch (ops button still works).
    "AI_EXTRACTION_MODE": "auto",
    // Upload scanning: 'structural' (default, on-stack — sniffed-type allowlist
    // plus PDF active-content detection, no external dependency), 'remote' (an
    // external AV service at SCAN_ENDPOINT), or 'both'. Every engine fails CLOSED:
    // bytes are only stored after a 'clean' verdict. Set SCAN_ENDPOINT (+ the
    // SCAN_AUTH secret) before selecting 'remote'/'both'.
    "SCAN_ENGINE": "structural",
    // Local/dev default only. `npm run cf:deploy` overrides this to "production"
    // (`wrangler deploy --var APP_ENV:production`), which gates dev-only OTP codes
    // and sets Secure cookies. A raw `wrangler deploy` would ship development — use
    // cf:deploy, or pass --var APP_ENV:production yourself.
    "APP_ENV": "production",
    // Email domains allowed to sign in to the ops console (comma-separated).
    "STAFF_EMAIL_DOMAINS": "openframe.com.au",
    // Email: set a verified From once Resend is configured (API key is a SECRET,
    // set via `wrangler secret put RESEND_API_KEY` — never commit it here):
    "EMAIL_FROM": "OpenFrame <no-reply@openframe.com.au>",
    // Enquiries: internal OpenFrame queue address (falls back to EMAIL_FROM), and
    // the SINGLE manufacturer handoff address used for every showroom appointment
    // (never stored per location). Set MANUFACTURER_TO to the real AMJ inbox to
    // enable the handoff email:
    "ENQUIRY_INTERNAL_TO": "enquiries@openframe.com.au",
    "MANUFACTURER_TO": "gediminas.bereznevicius@gmail.com",
    // Sanity catalogue source (Worker). Client uses VITE_SANITY_* in a .env:
    "SANITY_PROJECT_ID": "xjtrm1ex", "SANITY_DATASET": "production",
    // Prod staff auth via Cloudflare Access — set when the ops.* app is deployed:
    "ACCESS_TEAM_DOMAIN": "drg-group", "ACCESS_AUD": "89cb7205063857ae100e0d0a33d8f39f29e7f66c680b4370a177217c591edf77"
  }
}
