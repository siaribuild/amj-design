{
  "name": "apertly",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:api": "wrangler dev --var APP_ENV:development --var ACCESS_TEAM_DOMAIN: --var ACCESS_AUD:",
    "db:migrate:local": "wrangler d1 migrations apply apertly-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply apertly-db --remote",
    "db:reset": "node scripts/reset-db.mjs",
    "cf:deploy": "vite build && wrangler deploy --var APP_ENV:production",
    "preflight": "node scripts/preflight.mjs",
    "test": "npm run typecheck:gate && npm run test:pure && npm run test:heavy",
    "test:all": "npm run test && npm run test:web",
    "test:pure": "node --test --test-concurrency=12 scripts/tests/docs.test.mjs scripts/tests/unit.test.mjs scripts/tests/catalogue.test.mjs scripts/tests/catalogue-ndjson.test.mjs scripts/tests/seo.test.mjs scripts/tests/scan.test.mjs scripts/tests/estimator-derive.test.mjs scripts/tests/estimator-rules.test.mjs scripts/tests/estimator-learning.test.mjs scripts/tests/estimator-recommendation.test.mjs scripts/tests/recommendation-ladder.test.mjs scripts/tests/recommendation-contract.test.mjs scripts/tests/thermal-selection.test.mjs scripts/tests/thermal-default-band.test.mjs scripts/tests/ai-foundation.test.mjs scripts/tests/ai-jobs.test.mjs scripts/tests/ai-pipeline.test.mjs scripts/tests/schedule.test.mjs scripts/tests/composite.test.mjs scripts/tests/estimator-split.test.mjs scripts/tests/drawing.test.mjs scripts/tests/pairing.test.mjs scripts/tests/compatibility.test.mjs scripts/tests/composite-select.test.mjs scripts/tests/email-templates.test.mjs scripts/tests/pricing-golden.test.mjs scripts/tests/referral-codes.test.mjs scripts/tests/referral-screens.test.mjs",
    "test:heavy": "node --test --test-concurrency=2 scripts/tests/build.test.mjs scripts/tests/api.test.mjs scripts/tests/api-edge.test.mjs scripts/tests/registration.test.mjs scripts/tests/trade-verification.test.mjs scripts/tests/delivery.test.mjs scripts/tests/referral-lifecycle.test.mjs scripts/tests/referral-pricing.test.mjs scripts/tests/referral-security.test.mjs",
    "test:unit": "node --test scripts/tests/unit.test.mjs",
    "test:schedule": "node --test scripts/tests/schedule.test.mjs",
    "test:web": "playwright test",
    "test:coverage": "c8 --reporter=text --reporter=html --src src --src worker node --test scripts/tests/unit.test.mjs scripts/tests/catalogue.test.mjs",
    "test:catalogue": "node --test --test-concurrency=1 scripts/tests/catalogue.test.mjs scripts/tests/catalogue-ndjson.test.mjs scripts/tests/seo.test.mjs",
    "test:build": "node --test scripts/tests/build.test.mjs",
    "test:api": "node --test --test-concurrency=1 scripts/tests/api.test.mjs scripts/tests/api-edge.test.mjs",
    "test:scan": "node --test scripts/tests/scan.test.mjs",
    "test:estimator": "node --test scripts/tests/estimator-derive.test.mjs",
    "test:estimator-rules": "node --test scripts/tests/estimator-rules.test.mjs",
    "test:estimator-learning": "node --test scripts/tests/estimator-learning.test.mjs",
    "test:estimator-recommendation": "node --test scripts/tests/estimator-recommendation.test.mjs",
    "test:ladder": "node --test scripts/tests/recommendation-ladder.test.mjs scripts/tests/recommendation-contract.test.mjs",
    "test:thermal": "node --test scripts/tests/thermal-selection.test.mjs",
    "test:thermal-default": "node --test scripts/tests/thermal-default-band.test.mjs",
    "test:ai-foundation": "node --test scripts/tests/ai-foundation.test.mjs",
    "test:ai-jobs": "node --test scripts/tests/ai-jobs.test.mjs",
    "test:ai-pipeline": "node --test scripts/tests/ai-pipeline.test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:gate": "node scripts/typecheck.mjs --fatal-only",
    "test:composite": "node --test scripts/tests/composite.test.mjs scripts/tests/estimator-split.test.mjs",
    "test:drawing": "node --test scripts/tests/drawing.test.mjs",
    "test:pairing": "node --test scripts/tests/pairing.test.mjs",
    "test:compatibility": "node --test scripts/tests/compatibility.test.mjs scripts/tests/composite-select.test.mjs",
    "test:delivery": "node --test --test-concurrency=1 scripts/tests/delivery.test.mjs",
    "test:trade": "node --test --test-concurrency=1 scripts/tests/trade-verification.test.mjs",
    "test:email": "node --test scripts/tests/email-templates.test.mjs",
    "test:referral": "node --test --test-concurrency=1 scripts/tests/pricing-golden.test.mjs scripts/tests/referral-lifecycle.test.mjs scripts/tests/referral-pricing.test.mjs scripts/tests/referral-codes.test.mjs scripts/tests/referral-screens.test.mjs scripts/tests/referral-security.test.mjs",
    "test:docs": "node --test scripts/tests/docs.test.mjs",
    "test:registration": "node --test --test-concurrency=1 scripts/tests/registration.test.mjs"
  },
