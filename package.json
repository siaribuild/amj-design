  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260710.1",
    "@nizos/probity": "^1.10.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "c8": "^10.1.3",
    "esbuild": "0.25.12",
    "tailwindcss": "4.1.12",
    "typescript": "^7.0.2",
    "vite": "6.3.5",
    "wrangler": "4.111.0"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
